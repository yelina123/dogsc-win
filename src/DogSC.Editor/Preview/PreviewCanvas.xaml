<UserControl x:Class="DogSC.Editor.Preview.PreviewCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="640"
             Background="#000000">
    <Grid x:Name="RootGrid">
        <!-- 视频预览区 -->
        <Grid x:Name="VideoContainer" ClipToBounds="True">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            
            <!-- 3D 变换容器 -->
            <Border x:Name="TransformBorder" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ScaleTransform"/>
                        <RotateTransform x:Name="RotateTransform"/>
                        <TranslateTransform x:Name="TranslateTransform"/>
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
            
            <!-- 相机叠加层 -->
            <Border x:Name="CameraOverlay" Width="320" Height="180"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20" CornerRadius="8"
                    Background="#33000000" Visibility="Collapsed">
                <Image x:Name="CameraImage" Stretch="UniformToFill"/>
            </Border>
            
            <!-- 聚焦虚化遮罩 -->
            <Canvas x:Name="FocusCanvas" IsHitTestVisible="False">
                <Ellipse x:Name="FocusEllipse" Stroke="#FFFFFF" StrokeThickness="2" 
                         StrokeDashArray="4,2" Visibility="Collapsed"/>
            </Canvas>
        </Grid>
        
        <!-- 播放控制栏 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                Background="#AA2D2D30" CornerRadius="20" Padding="15,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="⏮" Click="Rewind_Click" Background="Transparent" Foreground="White" BorderThickness="0" Width="36" Height="36" FontSize="16" Cursor="Hand"/>
                <Button Content="◀" Click="PreviousFrame_Click" Background="Transparent" Foreground="White" BorderThickness="0" Width="36" Height="36" FontSize="16" Cursor="Hand"/>
                <Button x:Name="PlayButton" Content="▶" Click="PlayPause_Click" 
                        Background="#007ACC" Foreground="White" BorderThickness="0" Width="48" Height="48" FontSize="20" Margin="10,0" Cursor="Hand"/>
                <Button Content="▶|" Click="NextFrame_Click" Background="Transparent" Foreground="White" BorderThickness="0" Width="36" Height="36" FontSize="16" Cursor="Hand"/>
                <Button Content="⏭" Click="Forward_Click" Background="Transparent" Foreground="White" BorderThickness="0" Width="36" Height="36" FontSize="16" Cursor="Hand"/>
                <TextBlock x:Name="TimeDisplay" Text="00:00 / 00:00" 
                           Foreground="White" VerticalAlignment="Center" Margin="15,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
