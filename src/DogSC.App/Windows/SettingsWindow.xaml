<Window x:Class="DogSC.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E"
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="设置" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1" Background="#2D2D30" Foreground="White">
            <TabItem Header="通用">
                <StackPanel Margin="10">
                    <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Foreground="White" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SoundCheck" Content="录制完成提示音" Foreground="White" Margin="0,0,0,10"/>
                    <CheckBox x:Name="MinimizeCheck" Content="录制时最小化到托盘" Foreground="White" Margin="0,0,0,10"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="录制">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="默认帧率:" Foreground="White" Width="80" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DefaultFpsBox" Background="#2D2D30" Foreground="White" Width="100">
                            <ComboBoxItem Content="30 FPS"/>
                            <ComboBoxItem Content="60 FPS" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ShowCursorCheck" Content="默认显示光标" Foreground="White" IsChecked="True" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SystemAudioCheck" Content="默认录制系统声音" Foreground="White" IsChecked="True" Margin="0,0,0,10"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="导出">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="导出格式:" Foreground="White" Width="80" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DefaultFormatBox" Background="#2D2D30" Foreground="White" Width="120">
                            <ComboBoxItem Content="MP4" IsSelected="True"/>
                            <ComboBoxItem Content="MKV"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="HardwareAccelCheck" Content="启用硬件加速" Foreground="White" IsChecked="True" Margin="0,0,0,10"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="关于">
                <StackPanel Margin="10">
                    <TextBlock Text="DogSC for Windows" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="版本: 0.1.0" Foreground="Gray" Margin="0,0,0,10"/>
                    <TextBlock Text="原项目: github.com/laogou717/dogsc" Foreground="Gray" Margin="0,0,0,10"/>
                    <TextBlock Text="License: MIT" Foreground="Gray"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="关闭" Click="Close_Click" 
                Style="{StaticResource AccentButton}" Width="100" HorizontalAlignment="Right" Margin="0,15,0,0"/>
    </Grid>
</Window>
