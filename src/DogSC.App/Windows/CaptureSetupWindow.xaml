<Window x:Class="DogSC.App.Windows.CaptureSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制设置" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="录制设置" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <!-- 录制源 -->
            <TextBlock Text="录制源" Foreground="#007ACC" FontWeight="Bold" Margin="0,0,0,5"/>
            <RadioButton x:Name="ScreenRadio" Content="全屏" Foreground="White" IsChecked="True" Margin="0,0,0,5"/>
            <RadioButton x:Name="WindowRadio" Content="窗口" Foreground="White" Margin="0,0,0,5"/>
            <RadioButton x:Name="RegionRadio" Content="区域" Foreground="White" Margin="0,0,0,5"/>

            <Separator Margin="0,10" Background="#3E3E40"/>

            <!-- 音频 -->
            <TextBlock Text="音频" Foreground="#007ACC" FontWeight="Bold" Margin="0,0,0,5"/>
            <CheckBox x:Name="MicCheck" Content="麦克风" Foreground="White" IsChecked="True" Margin="0,0,0,5"/>
            <CheckBox x:Name="SystemAudioCheck" Content="系统声音" Foreground="White" IsChecked="True" Margin="0,0,0,5"/>

            <Separator Margin="0,10" Background="#3E3E40"/>

            <!-- 摄像头 -->
            <CheckBox x:Name="CameraCheck" Content="录制摄像头" Foreground="White" Margin="0,0,0,5"/>

            <Separator Margin="0,10" Background="#3E3E40"/>

            <!-- 光标 -->
            <CheckBox x:Name="CursorCheck" Content="录制光标" Foreground="White" IsChecked="True" Margin="0,0,0,5"/>

            <Separator Margin="0,10" Background="#3E3E40"/>

            <!-- 帧率 -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="帧率:" Foreground="White" VerticalAlignment="Center" Width="60"/>
                <ComboBox x:Name="FpsBox" Background="#2D2D30" Foreground="White" Width="100">
                    <ComboBoxItem Content="30 FPS"/>
                    <ComboBoxItem Content="60 FPS" IsSelected="True"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Click="Cancel_Click" Style="{StaticResource DarkButton}" Width="80"/>
            <Button Content="开始录制" Click="Start_Click" Style="{StaticResource AccentButton}" Width="100" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
