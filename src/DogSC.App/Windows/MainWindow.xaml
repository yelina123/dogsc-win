<Window x:Class="DogSC.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:DogSC.Editor.Timeline;assembly=DogSC.Editor"
        xmlns:preview="clr-namespace:DogSC.Editor.Preview;assembly=DogSC.Editor"
        xmlns:inspector="clr-namespace:DogSC.Editor.Inspector;assembly=DogSC.Editor"
        Title="DogSC" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="White">
            <MenuItem Header="文件">
                <MenuItem Header="新建项目" Click="NewProject_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="打开项目..." Click="OpenProject_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="保存项目" Click="SaveProject_Click" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="导出..." Click="Export_Click" InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="编辑">
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="重做" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="分割" InputGestureText="S"/>
                <MenuItem Header="删除" InputGestureText="Delete"/>
                <Separator/>
                <MenuItem Header="复制效果" InputGestureText="Ctrl+C"/>
                <MenuItem Header="粘贴效果" InputGestureText="Ctrl+V"/>
            </MenuItem>
            <MenuItem Header="录制">
                <MenuItem Header="开始录制" Click="StartRecording_Click" InputGestureText="Ctrl+R"/>
                <MenuItem Header="停止录制" Click="StopRecording_Click"/>
                <Separator/>
                <MenuItem Header="标记" Click="AddMarker_Click" InputGestureText="Ctrl+Alt+M"/>
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="放大时间线" InputGestureText="Ctrl++"/>
                <MenuItem Header="缩小时间线" InputGestureText="Ctrl+-"/>
                <MenuItem Header="适应窗口" InputGestureText="Ctrl+0"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于 DogSC" Click="About_Click"/>
                <MenuItem Header="快捷键" Click="Shortcuts_Click"/>
            </MenuItem>
        </Menu>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 预览区 -->
            <Grid Grid.Column="0" Background="#000000">
                <preview:PreviewCanvas x:Name="PreviewCanvas"/>
            </Grid>

            <!-- 检查器面板 -->
            <Border Grid.Column="1" Background="#2D2D30" BorderBrush="#3E3E40" BorderThickness="1,0,0,0">
                <inspector:InspectorPanel x:Name="InspectorPanel"/>
            </Border>
        </Grid>

        <!-- 时间线 -->
        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#3E3E40" BorderThickness="0,1,0,0">
            <editor:TimelineControl x:Name="TimelineControl"/>
        </Border>
    </Grid>
</Window>
