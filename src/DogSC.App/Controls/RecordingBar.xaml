<Window x:Class="DogSC.App.Controls.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecordingBar" Height="50" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False">
    <Border Background="#CC2D2D30" CornerRadius="25" BorderBrush="#3E3E40" BorderThickness="1">
        <Grid Margin="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 录制指示灯 -->
            <Ellipse Grid.Column="0" Width="12" Height="12" Fill="#FF4444" Margin="0,0,10,0"/>

            <!-- 时间显示 -->
            <TextBlock Grid.Column="1" x:Name="TimeText" Text="00:00" 
                       Foreground="White" FontSize="14" VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- 标记按钮 -->
            <Button Grid.Column="2" Content="⚑" Click="Marker_Click" 
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    FontSize="16" Margin="5,0" Cursor="Hand" ToolTip="添加标记 (Ctrl+Alt+M)"/>

            <!-- 备忘录按钮 -->
            <Button Grid.Column="3" Content="📝" Click="Memo_Click" 
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    FontSize="16" Margin="5,0" Cursor="Hand" ToolTip="备忘录"/>

            <!-- 停止按钮 -->
            <Button Grid.Column="4" Content="■" Click="Stop_Click" 
                    Background="#CCFF4444" Foreground="White" BorderThickness="0"
                    Width="30" Height="30" CornerRadius="15" Margin="5,0,0,0"
                    FontSize="14" Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
